# ==========================================
# DocuSetu Environment Variables
# ==========================================

# Frontend (Vite)
VITE_SUPABASE_URL=https://mock-supabase.docusetu.internal
VITE_SUPABASE_ANON_KEY=mock-anon-key-docusetu-enterprise-jwt-sample-token
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Backend (Node / Express)
PORT=5000
SUPABASE_URL=https://mock-supabase.docusetu.internal
SUPABASE_SERVICE_ROLE_KEY=mock-service-role-key-docusetu-enterprise-jwt-sample-token
GEMINI_API_KEY=your_google_gemini_api_key

# Node Environment
NODE_ENV=development

# Email Delivery Configuration (for Real OTP Email Dispatch)
# Option A: Resend API (Recommended - Free & Instant)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=DocuSetu <onboarding@resend.dev>

# Option B: Standard SMTP / Gmail App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="DocuSetu Trade Security" <no-reply@docusetu.io>


